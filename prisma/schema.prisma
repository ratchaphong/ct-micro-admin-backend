// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["cart"]
}

model CartItem {
  id        String    @id @default(uuid())
  userId    String
  productId String
  quantity  Int
  createdAt DateTime  @default(now())
  deletedAt DateTime? // 👈 เก็บเวลาที่ลบ (nullable)
  isDeleted Boolean   @default(false) // 👈 ระบุว่า soft deleted หรือไม่

  @@schema("cart")
}

model Order {
  id         String   @id @default(uuid())
  userId     String
  productId  String
  totalPrice Float
  createdAt  DateTime @default(now())
  status     String   @default("COMPLETED")

  @@schema("cart")
}
